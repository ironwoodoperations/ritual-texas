{
  "name": "FollowUpQueue",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "call"
      ],
      "default": "email"
    },
    "toName": {
      "type": "string"
    },
    "toPhone": {
      "type": "string"
    },
    "toEmail": {
      "type": "string"
    },
    "messageDraft": {
      "type": "string"
    },
    "relatedType": {
      "type": "string",
      "enum": [
        "booking",
        "spa",
        "restaurant",
        "other"
      ],
      "default": "other"
    },
    "relatedId": {
      "type": "string"
    },
    "dueAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "snoozed",
        "done"
      ],
      "default": "pending"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel",
    "toName",
    "messageDraft"
  ]
}
{
  "name": "PressItem",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "title": {
      "type": "string",
      "description": "Article/feature title"
    },
    "publisher": {
      "type": "string",
      "description": "Publication name"
    },
    "url": {
      "type": "string",
      "description": "Link to article"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Magazine cover or publication logo image"
    },
    "pull_quote": {
      "type": "string",
      "description": "Featured quote from article (optional)"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "publisher",
    "url"
  ]
}
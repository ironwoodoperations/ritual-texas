{
  "name": "ReviewPlacement",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "key": {
      "type": "string",
      "description": "Placement key (e.g., home.hero, treatments.header)"
    },
    "title": {
      "type": "string",
      "description": "Internal label for this placement"
    },
    "testimonial_slug": {
      "type": "string",
      "description": "Slug of testimonial to display"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key",
    "testimonial_slug"
  ]
}
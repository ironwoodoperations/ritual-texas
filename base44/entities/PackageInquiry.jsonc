{
  "name": "PackageInquiry",
  "type": "object",
  "properties": {
    "package_slug": {
      "type": "string"
    },
    "package_title": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "preferred_checkin": {
      "type": "string",
      "format": "date"
    },
    "preferred_checkout": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number",
      "default": 1
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "completed_booked",
        "completed_not_booked"
      ],
      "default": "new"
    }
  },
  "required": [
    "package_slug",
    "package_title",
    "full_name",
    "email"
  ]
}
{
  "name": "Package",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier (e.g. soul-revival)"
    },
    "title": {
      "type": "string",
      "description": "Package name"
    },
    "subtitle": {
      "type": "string",
      "description": "Short tagline"
    },
    "price": {
      "type": "number",
      "description": "Price in dollars"
    },
    "hero_image_url": {
      "type": "string",
      "description": "Hero image URL"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description shown on list and detail page"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of what is included in the package"
    },
    "fine_print": {
      "type": "string",
      "description": "Good to know / fine print info"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this package is visible on the site"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = first)"
    }
  },
  "required": [
    "title",
    "slug",
    "price"
  ]
}
{
  "name": "CateringMenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "starters",
        "salads",
        "entrees",
        "sides",
        "desserts",
        "bar_packages",
        "add_ons",
        "chef_specials"
      ],
      "default": "entrees"
    },
    "description": {
      "type": "string"
    },
    "base_price": {
      "type": "number"
    },
    "serving_size": {
      "type": "number",
      "description": "How many guests one unit serves"
    },
    "unit": {
      "type": "string",
      "description": "e.g. per person, per tray, per gallon"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty_per_serving": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "proteins",
              "produce",
              "dry_goods",
              "dairy",
              "alcohol",
              "paper_disposables",
              "rentals",
              "other"
            ]
          },
          "cost_per_unit": {
            "type": "number"
          },
          "vendor": {
            "type": "string"
          }
        }
      }
    },
    "prep_notes": {
      "type": "string"
    },
    "margin_percent": {
      "type": "number",
      "default": 30
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "base_price",
    "category"
  ]
}
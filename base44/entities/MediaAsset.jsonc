{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Media title/name"
    },
    "type": {
      "type": "string",
      "enum": [
        "photo",
        "video"
      ],
      "description": "Media type"
    },
    "url": {
      "type": "string",
      "description": "Media URL"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "url",
    "type"
  ]
}